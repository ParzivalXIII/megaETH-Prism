# RPC WebSocket endpoint (Anvil default: ws://127.0.0.1:8545, MegaETH testnet: wss://carrot.megaeth.com/ws)
WS_URL=ws://127.0.0.1:8545
# Chain ID (31337 = Anvil, 6343 = MegaETH testnet, 4326 = MegaETH mainnet)
CHAIN_ID=31337
# Subscription type: auto (try miniBlocks → fallback to newHeads), miniBlocks, newHeads
SUBSCRIPTION_TYPE=auto

# Redis connection string
REDIS_URL=redis://127.0.0.1:6379/0
# PostgreSQL async connection string
POSTGRES_URL=postgresql+asyncpg://megaeth:megaeth@127.0.0.1:5432/megaeth
# Qdrant HTTP endpoint
QDRANT_URL=http://127.0.0.1:6333
# Cohere Embed API endpoint
COHERE_EMBED_URL=http://127.0.0.1:8000

# Redis Stream name for block ingestion
STREAM_NAME=megaeth:raw:miniBlocks
# Maximum stream length before trimming
STREAM_MAXLEN=500000
# Consumer group name for PostgreSQL worker
CONSUMER_GROUP_POSTGRES=megaeth:workers:postgres
# Consumer group name for Qdrant worker
CONSUMER_GROUP_QDRANT=megaeth:workers:qdrant
# Dead letter stream name
DEAD_LETTER_STREAM=megaeth:raw:miniBlocks:dead

# WebSocket keepalive interval in seconds (30s for MegaETH WS; Anvil doesn't require it)
KEEPALIVE_INTERVAL_SEC=30
# Exponential backoff base (seconds)
RECONNECT_BACKOFF_BASE=1.0
# Exponential backoff maximum (seconds)
RECONNECT_BACKOFF_CAP=16.0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Running inside Docker (true/false). When true, uses Docker DNS for service discovery
DOCKER_ENV=false

# Embedding vector dimensions (must match cohere-embed model)
EMBEDDING_DIMENSIONS=1024
# Cohere embed model name
EMBEDDING_MODEL=embed-english-v3.0
